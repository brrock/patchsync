{
  "name": "@brrock/patchsync-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:action && bun run build:cli",
    "build:action": "bun run --cwd packages/action build",
    "build:cli": "bun run --cwd packages/cli build",
    "typecheck": "bun run --cwd packages/action typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
